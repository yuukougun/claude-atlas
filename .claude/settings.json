{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "WebFetch(domain:atcoder.jp)",
      "WebFetch(domain:*.atcoder.jp)",
      "WebFetch(domain:codeforces.com)",
      "WebFetch(domain:*.codeforces.com)",
      "WebFetch(domain:anthropic.skilljar.com)",
      "WebFetch(domain:*.anthropic.skilljar.com)",
      "WebFetch(domain:anthropic-partners.skilljar.com)",
      "WebFetch(domain:*.anthropic-partners.skilljar.com)",
      "WebFetch(domain:chessprogramming.org)",
      "WebFetch(domain:*.chessprogramming.org)",
      "WebFetch(domain:israynotarray.com)",
      "WebFetch(domain:*.israynotarray.com)",
      "WebFetch(domain:posfie.com)",
      "WebFetch(domain:*.posfie.com)",
      "WebFetch(domain:techcrunch.com)",
      "WebFetch(domain:*.techcrunch.com)",
      "WebFetch(domain:threadreaderapp.com)",
      "WebFetch(domain:*.threadreaderapp.com)",
      "WebFetch(domain:bleepingcomputer.com)",
      "WebFetch(domain:*.bleepingcomputer.com)",
      "WebFetch(domain:oreilly.com)",
      "WebFetch(domain:*.oreilly.com)",
      "WebFetch(domain:theregister.com)",
      "WebFetch(domain:*.theregister.com)",
      "WebFetch(domain:media.defcon.org)",
      "WebFetch(domain:*.media.defcon.org)",
      "WebFetch(domain:reddit.com)",
      "WebFetch(domain:*.reddit.com)",
      "WebFetch(domain:reddit.sentinel-team.org)",
      "WebFetch(domain:*.reddit.sentinel-team.org)",
      "Edit(/docs/llms.txt)",
      "Edit(/docs/lists/**)",
      "Edit(/docs/*/index.md)",
      "Edit(/docs/assets/data/**)",
      "Edit(/nav.yml)",
      "Edit(/schema/*.schema.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
